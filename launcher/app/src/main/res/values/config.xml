<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher configuration. Edit this file, then run launcher/build-and-install.sh.
  Package names: on the TV run `pm list packages` (tools/tv.py 'pm list packages').

  Everything here ships empty on purpose: the defaults suit nobody's box in
  particular. Fill in the dock and boot app for the TV you actually own.
-->
<resources>

    <!-- Apps pinned to the dock row at the bottom, in this order. Missing apps are skipped.
         Left empty by default, so the grid is simply alphabetical. Examples:
           com.netflix.ninja        (Netflix)
           com.amazon.amazonvideo.livingroom (Prime Video)
           com.google.android.youtube.tv     (YouTube) -->
    <string-array name="dock_apps">
    </string-array>

    <!-- Apps never shown as tiles (e.g. the Live TV app, which the Inputs menu already covers). -->
    <string-array name="hidden_apps">
    </string-array>

    <!-- The TV's Live TV / tuner app, offered at the end of the Inputs menu. Leave empty to omit. -->
    <string name="live_tv_package" translatable="false"></string>

    <!-- Intent action that opens the tuner directly, when the box needs more than the package name. -->
    <string name="live_tv_action" translatable="false"></string>

    <!-- Optional: a system service + action that show a nicer input/source panel, e.g. the vendor's own. -->
    <string name="source_panel_service" translatable="false"></string>
    <string name="source_panel_action" translatable="false"></string>

    <!-- Optional: what the remote's Input/TV button should do. Empty falls back to Android's own. -->
    <string name="input_action" translatable="false"></string>

    <!-- Tiles per row in the grid; the dock always has this many slots. -->
    <integer name="columns">4</integer>

    <!-- How many grid rows stay visible between the top bar and the dock. -->
    <integer name="rows_below_dock">0</integer>

    <!-- Persian (Jalali) calendar for the date, for Iranian boxes. -->
    <bool name="shamsi_date">false</bool>

    <!-- Let other apps plug a card into the launcher (see CardFeature). Off by default: a module only
         appears when the user explicitly enables it. -->
    <bool name="module_cards">false</bool>

    <!-- An app to show as a badge on the Wi-Fi pill, e.g. a VPN client. Empty hides the badge. -->
    <string name="vpn_app" translatable="false"></string>

    <!-- Add a "Default home" tile at the end of the grid, so the desktop can be changed from the sofa. -->
    <bool name="show_home_settings_shortcut">true</bool>

    <!--
      Remote buttons that should open the quick settings panel (HomeKeyService), for boxes that report
      the Settings/选项 button under a raw scan code instead of KEYCODE_SETTINGS. Empty by default:
      KEYCODE_SETTINGS is handled without any configuration, and nothing else is taken from the app
      behind until it is listed here. To find your remote's code, watch it with
      `adb shell getevent -lt` and press the button.
    -->
    <integer-array name="settings_key_scancodes">
    </integer-array>
</resources>
