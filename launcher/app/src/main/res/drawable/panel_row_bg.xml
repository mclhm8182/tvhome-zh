<?xml version="1.0" encoding="utf-8"?>
<!--
  Row background for the wallpaper / favourites panels.

  The top-bar pills use pill_bg, whose focused state is a near-solid white fill (#F5FFFFFF). That reads
  correctly on a small button but as a glaring white slab on a full-width list row, and it hides the
  label. These rows get their own treatment instead: a faint fill plus a brighter rim, so the focused
  row reads as a ring of light around the text, echoing the glass highlight on the app tiles.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#1FFFFFFF" />
            <stroke android:width="1.5dp" android:color="#B0FFFFFF" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#1FFFFFFF" />
            <stroke android:width="1.5dp" android:color="#B0FFFFFF" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0DFFFFFF" />
            <stroke android:width="1dp" android:color="#1FFFFFFF" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>