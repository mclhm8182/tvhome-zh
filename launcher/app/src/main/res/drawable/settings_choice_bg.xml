<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#5574A987" />
            <corners android:radius="14dp" />
            <stroke android:width="2dp" android:color="#FFB9E7C7" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#334DAE6D" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#FF4DAE6D" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF242B34" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
