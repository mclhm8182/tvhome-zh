<?xml version="1.0" encoding="utf-8"?>
<!--
  The Hidden apps panel: every app the user took off the desk, with a tap to put it back.

  Same glass sheet and rows as the Favourites panel, with a line on top that says how many there
  are (or that there are none). Width and height are set from the content when the popup is built.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/glass_panel"
    android:padding="6dp"
    android:elevation="12dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="2dp"
        android:text="@string/hidden_apps"
        android:textColor="@drawable/pill_text"
        android:textSize="13sp"
        android:fontVariationSettings="'wght' 500" />

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="6dp"
        android:textColor="@drawable/pill_text_dim"
        android:textSize="11sp"
        android:fontVariationSettings="'wght' 400" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:scrollbars="none" />
</LinearLayout>
