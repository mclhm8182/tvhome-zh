<?xml version="1.0" encoding="utf-8"?>
<!--
  The Favourites panel: a glass dropdown that hangs under the 常用 button, built like the Inputs menu
  upstream — no title bar, no close button (Back dismisses it), 6dp of padding and rows that carry
  their own focus pill. Width and height are set from the content when the popup is built.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/glass_panel"
    android:padding="6dp"
    android:elevation="12dp">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:scrollbars="none" />
</LinearLayout>