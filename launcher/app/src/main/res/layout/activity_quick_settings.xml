<?xml version="1.0" encoding="utf-8"?>
<!--
  Quick settings, opened by the remote's Settings (选项) button through HomeKeyService: the same glass
  rows as the Inputs dropdown, parked under the Settings pill so it lines up on the desktop and sits in
  the top right over whatever app is playing. The whole screen is a scrim that closes it on a click
  outside the panel; the window itself is translucent, so the app behind keeps running.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrim"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="105dp"
        android:layout_marginEnd="56dp"
        android:orientation="vertical"
        android:background="@drawable/glass_panel"
        android:padding="6dp"
        android:elevation="12dp">

        <LinearLayout
            android:id="@+id/rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</FrameLayout>