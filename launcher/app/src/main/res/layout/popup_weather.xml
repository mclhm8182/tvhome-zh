<?xml version="1.0" encoding="utf-8"?>
<!--
  The weather page, laid out the way Apple's Weather app reads on a TV: the city, one very large
  temperature with the condition beside it, then a horizontal hourly strip, then the coming days as
  rows with a bar that spans the week's range. Everything is sized for three metres away.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wxContent"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/wx_panel"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingEnd="22dp"
    android:paddingTop="16dp"
    android:paddingBottom="14dp">

    <!-- Where this is for, so a wrong guess is obvious and fixable. -->
    <TextView
        android:id="@+id/place"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@drawable/pill_text_dim"
        android:textSize="15sp"
        android:fontFamily="@font/outfit"
        android:fontVariationSettings="'wght' 500"
        android:letterSpacing="0.16"
        android:textAllCaps="true" />

    <!-- The one big number, with the sky beside it. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="horizontal"
        android:gravity="bottom">

        <TextView
            android:id="@+id/temp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF"
            android:textSize="42sp"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 200"
            android:includeFontPadding="false" />

        <ImageView
            android:id="@+id/icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="14dp"
            android:layout_marginBottom="8dp"
            android:tint="#FFFFFFFF"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/sky"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginBottom="10dp"
            android:textColor="#E6FFFFFF"
            android:textSize="19sp"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 400" />
    </LinearLayout>

    <TextView
        android:id="@+id/feels"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#B3FFFFFF"
        android:textSize="14sp"
        android:fontFamily="@font/outfit"
        android:fontVariationSettings="'wght' 400" />

    <!-- Air quality: a coloured pill, or gone when the service has nothing for this place. -->
    <TextView
        android:id="@+id/air"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:textColor="#FFFFFFFF"
        android:textSize="14sp"
        android:fontFamily="@font/outfit"
        android:fontVariationSettings="'wght' 500"
        android:visibility="gone" />

    <TextView
        android:id="@+id/message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#B3FFFFFF"
        android:textSize="14sp"
        android:fontFamily="@font/outfit"
        android:fontVariationSettings="'wght' 400"
        android:visibility="gone" />

    <!-- The next hours: a strip, the way Apple shows them. -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/weather_hourly"
        android:textColor="@drawable/pill_text_dim"
        android:textSize="13sp"
        android:fontFamily="@font/outfit"
        android:fontVariationSettings="'wght' 500"
        android:letterSpacing="0.16" />

    <HorizontalScrollView
        android:id="@+id/hourly"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/hourlyRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- The coming days, each with a bar across the week's range. -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/weather_days"
        android:textColor="@drawable/pill_text_dim"
        android:textSize="13sp"
        android:fontFamily="@font/outfit"
        android:fontVariationSettings="'wght' 500"
        android:letterSpacing="0.16" />

    <LinearLayout
        android:id="@+id/days"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/updated"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:textColor="#8CFFFFFF"
        android:textSize="12sp"
        android:fontFamily="@font/outfit"
        android:fontVariationSettings="'wght' 400"
        android:visibility="gone" />

    <!-- Stacked, not side by side: down moves between them, the way every other panel here reads. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnChangeCity"
            style="@style/TopButton"
            android:layout_marginStart="0dp"
            android:text="@string/weather_change_city"
            android:drawableStart="@drawable/ic_wx_search" />

        <TextView
            android:id="@+id/btnLocate"
            style="@style/TopButton"
            android:text="@string/weather_locate"
            android:drawableStart="@drawable/ic_wx_locate" />
    </LinearLayout>
</LinearLayout>
