<?xml version="1.0" encoding="utf-8"?>
<!--
  The Desktop settings panel.

  Same construction as the Inputs menu upstream: a glass sheet with 6dp of padding and rows that
  carry their own focus pill, so no title bar, no border per row and no close button are needed.
  Rows with a second line of status text are 52dp, plain rows 42dp, which is the rhythm the rest
  of the launcher's menus use.

  The rows live in a ScrollView because there are more of them than fit under the top bar on a
  1080p screen: without it the last rows hang below the bottom edge and the remote can never
  reach them. Its height is set from the room the top bar leaves when the panel is built.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/glass_panel"
    android:padding="6dp"
    android:elevation="12dp">

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:scrollbars="none"
        android:descendantFocusability="afterDescendants">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

    <!-- Bing daily: the one option that fetches on its own, so it shows its state as a tick. -->
    <LinearLayout
        android:id="@+id/rowBing"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/input_row_bg"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:duplicateParentState="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bing_daily"
                android:textColor="@drawable/pill_text"
                android:duplicateParentState="true"
                android:textSize="15sp"
                android:fontVariationSettings="'wght' 500" />

            <TextView
                android:id="@+id/bingStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@drawable/pill_text_dim"
                android:duplicateParentState="true"
                android:textSize="11sp"
                android:fontVariationSettings="'wght' 400" />
        </LinearLayout>

        <ImageView
            android:id="@+id/bingTick"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_tick"
            android:tint="@drawable/pill_text"
            android:duplicateParentState="true"
            android:contentDescription="@null" />
    </LinearLayout>

    <!-- Icons per row. The value is always written out underneath, so the current state is
         visible without pressing anything. -->
    <LinearLayout
        android:id="@+id/rowColumns"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/input_row_bg"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:duplicateParentState="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/columns_title"
                android:textColor="@drawable/pill_text"
                android:duplicateParentState="true"
                android:textSize="15sp"
                android:fontVariationSettings="'wght' 500" />

            <TextView
                android:id="@+id/columnsStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@drawable/pill_text_dim"
                android:duplicateParentState="true"
                android:textSize="11sp"
                android:fontVariationSettings="'wght' 400" />
        </LinearLayout>

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_chevron"
            android:tint="@drawable/pill_text"
            android:duplicateParentState="true"
            android:contentDescription="@null" />
    </LinearLayout>

    <!-- Whether the Menu button also opens quick settings while another app is in front. Off by
         default: catching it everywhere takes that button away from the app behind. -->
    <LinearLayout
        android:id="@+id/rowMenuKey"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/input_row_bg"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:duplicateParentState="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/menu_key_everywhere"
                android:textColor="@drawable/pill_text"
                android:duplicateParentState="true"
                android:textSize="15sp"
                android:fontVariationSettings="'wght' 500" />

            <TextView
                android:id="@+id/menuKeyStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@drawable/pill_text_dim"
                android:duplicateParentState="true"
                android:textSize="11sp"
                android:fontVariationSettings="'wght' 400" />
        </LinearLayout>
    </LinearLayout>

    <!-- The weather, off by default: it is the one feature that talks to the network. -->
    <LinearLayout
        android:id="@+id/rowWeather"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/input_row_bg"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:duplicateParentState="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/weather"
                android:textColor="@drawable/pill_text"
                android:duplicateParentState="true"
                android:textSize="15sp"
                android:fontVariationSettings="'wght' 500" />

            <TextView
                android:id="@+id/weatherStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@drawable/pill_text_dim"
                android:duplicateParentState="true"
                android:textSize="11sp"
                android:fontVariationSettings="'wght' 400" />
        </LinearLayout>
    </LinearLayout>

    <!-- Turn the tweens down for a box whose GPU cannot keep up with them. -->
    <LinearLayout
        android:id="@+id/rowMotion"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/input_row_bg"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:duplicateParentState="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/reduced_motion"
                android:textColor="@drawable/pill_text"
                android:duplicateParentState="true"
                android:textSize="15sp"
                android:fontVariationSettings="'wght' 500" />

            <TextView
                android:id="@+id/motionStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@drawable/pill_text_dim"
                android:duplicateParentState="true"
                android:textSize="11sp"
                android:fontVariationSettings="'wght' 400" />
        </LinearLayout>
    </LinearLayout>

    <!-- Every tile shows its name, not only the focused one. Off by default: the names take room
         the grid would rather have, and most people recognise their own icons. -->
    <LinearLayout
        android:id="@+id/rowNames"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/input_row_bg"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:duplicateParentState="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/always_show_names"
                android:textColor="@drawable/pill_text"
                android:duplicateParentState="true"
                android:textSize="15sp"
                android:fontVariationSettings="'wght' 500" />

            <TextView
                android:id="@+id/namesStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@drawable/pill_text_dim"
                android:duplicateParentState="true"
                android:textSize="11sp"
                android:fontVariationSettings="'wght' 400" />
        </LinearLayout>
    </LinearLayout>

    <!-- How tiles with no artwork of their own are drawn: the app's icon scaled up with its own
         edges stretched out, or the app's mark sized by area on a wash of its colour. -->
    <LinearLayout
        android:id="@+id/rowUnified"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/input_row_bg"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:duplicateParentState="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tile_style"
                android:textColor="@drawable/pill_text"
                android:duplicateParentState="true"
                android:textSize="15sp"
                android:fontVariationSettings="'wght' 500" />

            <TextView
                android:id="@+id/unifiedStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@drawable/pill_text_dim"
                android:duplicateParentState="true"
                android:textSize="11sp"
                android:fontVariationSettings="'wght' 400" />
        </LinearLayout>
    </LinearLayout>

    <!-- The apps the user took off the desk. Opens a list to put them back. -->
    <LinearLayout
        android:id="@+id/rowHidden"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/input_row_bg"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:duplicateParentState="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hidden_apps"
                android:textColor="@drawable/pill_text"
                android:duplicateParentState="true"
                android:textSize="15sp"
                android:fontVariationSettings="'wght' 500" />

            <TextView
                android:id="@+id/hiddenStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@drawable/pill_text_dim"
                android:duplicateParentState="true"
                android:textSize="11sp"
                android:fontVariationSettings="'wght' 400" />
        </LinearLayout>

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_chevron"
            android:tint="@drawable/pill_text"
            android:duplicateParentState="true"
            android:contentDescription="@null" />
    </LinearLayout>

    <!-- Whether the remote's own source button opens this launcher's Inputs menu. Off by default:
         a TV with its own source picker should keep it. -->
    <LinearLayout
        android:id="@+id/rowInputKey"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/input_row_bg"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:duplicateParentState="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/input_source_key"
                android:textColor="@drawable/pill_text"
                android:duplicateParentState="true"
                android:textSize="15sp"
                android:fontVariationSettings="'wght' 500" />

            <TextView
                android:id="@+id/inputKeyStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@drawable/pill_text_dim"
                android:duplicateParentState="true"
                android:textSize="11sp"
                android:fontVariationSettings="'wght' 400" />
        </LinearLayout>
    </LinearLayout>

    <!-- Pick a picture the user already has on the TV. -->
    <LinearLayout
        android:id="@+id/rowPick"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/input_row_bg"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/pick_wallpaper"
            android:textColor="@drawable/pill_text"
            android:duplicateParentState="true"
            android:textSize="15sp"
            android:fontVariationSettings="'wght' 500" />

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_chevron"
            android:tint="@drawable/pill_text"
            android:duplicateParentState="true"
            android:contentDescription="@null" />
    </LinearLayout>

    <!-- Remove the picture and go back to the plain background. -->
    <LinearLayout
        android:id="@+id/rowOff"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/input_row_bg"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/wallpaper_off"
            android:textColor="@drawable/pill_text"
            android:duplicateParentState="true"
            android:textSize="15sp"
            android:fontVariationSettings="'wght' 500" />

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_chevron"
            android:tint="@drawable/pill_text"
            android:duplicateParentState="true"
            android:contentDescription="@null" />
    </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
