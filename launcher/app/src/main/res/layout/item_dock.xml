<?xml version="1.0" encoding="utf-8"?>
<!--
  One app in the Favourites panel.

  Deliberately the same shape as the Inputs menu's rows upstream: 42dp tall, no border of its own,
  and a solid near-white pill when focused. The row text follows the row's focus state
  (duplicateParentState + pill_text), which is what makes the focused row readable without a border.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/item"
    android:layout_width="match_parent"
    android:layout_height="42dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/input_row_bg"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <ImageView
        android:id="@+id/icon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginEnd="12dp"
        android:duplicateParentState="true"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="@drawable/pill_text"
        android:duplicateParentState="true"
        android:textSize="15sp"
        android:fontFamily="@font/outfit"
        android:fontVariationSettings="'wght' 500" />

    <ImageView
        android:id="@+id/tick"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:src="@drawable/ic_tick"
        android:tint="@drawable/pill_text"
        android:duplicateParentState="true"
        android:contentDescription="@null" />
</LinearLayout>