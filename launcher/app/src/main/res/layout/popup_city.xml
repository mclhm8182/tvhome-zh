<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/glass_panel"
    android:orientation="vertical"
    android:padding="6dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="4dp"
        android:text="@string/weather_pick_title"
        android:textColor="@drawable/pill_text_dim"
        android:textSize="11sp"
        android:fontFamily="@font/outfit"
        android:fontVariationSettings="'wght' 500"
        android:letterSpacing="0.16"
        android:textAllCaps="true" />

    <!-- The TV's own keyboard does the typing; this only asks it to come up. -->
    <EditText
        android:id="@+id/cityInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="10dp"
        android:minWidth="360dp"
        android:hint="@string/weather_pick_hint"
        android:inputType="textCapWords"
        android:imeOptions="actionSearch"
        android:singleLine="true"
        android:textColor="#FFFFFFFF"
        android:textColorHint="#8CFFFFFF"
        android:textSize="15sp"
        android:fontFamily="@font/outfit"
        android:fontVariationSettings="'wght' 400" />

    <TextView
        android:id="@+id/btnSearch"
        style="@style/TopButton"
        android:layout_marginStart="10dp"
        android:layout_marginTop="8dp"
        android:text="@string/weather_search"
        android:drawableStart="@drawable/ic_wx_search" />

    <TextView
        android:id="@+id/message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="8dp"
        android:textColor="#A6FFFFFF"
        android:textSize="12sp"
        android:fontFamily="@font/outfit"
        android:fontVariationSettings="'wght' 400"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/results"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical" />
</LinearLayout>
